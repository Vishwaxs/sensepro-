# SensePro+ web configuration. Copy to apps/web/.env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# WebSocket base URL for the inference backend (capture page).
VITE_WS_URL=ws://localhost:8000/ws/capture

# Supabase project URL (Project Settings > API > Project URL).
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous / publishable key (Project Settings > API > anon public).
# This key ships to the browser; it is NOT the service-role key.
VITE_SUPABASE_ANON_KEY=

# Backend base for HTTP calls. Leave UNSET for local laptop dev (defaults to
# http://localhost:8000). For the phone QR demo behind ONE HTTPS tunnel, set to
# /api so calls go same-origin through the Vite proxy (see vite.config.ts).
VITE_API_BASE=/api

# The class this capture station records for. MUST equal the students'
# class_section in Supabase, or the QR claim rejects everyone (403).
VITE_CLASS_SECTION=MCA-4B

# Subjects displayed in the capture UI header.
VITE_CLASS_SUBJECT=Distributed Systems

# Origin the absentee QR sends a phone to. Leave UNSET to use the capture page's
# own origin. For the tunnel demo set to the public HTTPS tunnel URL (getUserMedia
# needs a secure context). Set at demo time — do not hard-code the ephemeral URL.
# VITE_CLAIM_BASE=https://your-tunnel.example.com
