# SensePro+ web configuration. Copy to apps/web/.env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# Capture WebSocket for the inference backend.
#   Local dev  : leave UNSET, or "/api/ws/capture" to go through the Vite proxy.
#   Production : the ABSOLUTE wss:// URL of the deployed backend, e.g.
#                wss://sensepro-api-xxxxx.a.run.app/ws/capture
# A static host (Vercel/Cloudflare/Netlify) serves from a CDN and cannot proxy a
# WebSocket upgrade, so in production the browser must open the socket against
# the API host directly. It MUST be wss:// — a ws:// socket on an https page is
# blocked as mixed content (resolveWsUrl upgrades it and warns).
VITE_WS_URL=/api/ws/capture

# Supabase project URL (Project Settings > API > Project URL).
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous / publishable key (Project Settings > API > anon public).
# This key ships to the browser; it is NOT the service-role key.
VITE_SUPABASE_ANON_KEY=

# Backend base for HTTP calls. Leave UNSET for local laptop dev (defaults to
# http://localhost:8000). For the phone QR demo behind ONE HTTPS tunnel, set to
# /api so calls go same-origin through the Vite proxy (see vite.config.ts).
VITE_API_BASE=/api

# The class this capture station records for. MUST equal the students'
# class_section in Supabase, or the QR claim rejects everyone (403).
VITE_CLASS_SECTION=MCA-4B

# Subjects displayed in the capture UI header.
VITE_CLASS_SUBJECT=Distributed Systems

# Origin the absentee QR sends a phone to. Leave UNSET to use the capture page's
# own origin. For the tunnel demo set to the public HTTPS tunnel URL (getUserMedia
# needs a secure context). Set at demo time — do not hard-code the ephemeral URL.
# VITE_CLAIM_BASE=https://your-tunnel.example.com

# Origin the browser calls for HTTP endpoints in production. Must be the
# deployed backend's https:// origin, and that origin must appear in the
# backend's ALLOW_ORIGINS or every call fails CORS.
# VITE_API_BASE=https://sensepro-api-xxxxx.a.run.app

# Clerk Authentication Publishable Key (Clerk Dashboard > API Keys).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Clerk Frontend API Proxy URL (production only).
# On Vercel, Clerk Production requires a server-side proxy because shared
# *.vercel.app domains cannot add custom DNS CNAME records.
# Leave UNSET for local dev (the Development instance works directly).
# VITE_CLERK_PROXY_URL=https://sensepro-six.vercel.app/__clerk

# ---------------------------------------------------------------------------
# Server-side only. These are read by the /__clerk proxy function
# (apps/web/api/clerk-proxy.js) and NEVER reach the browser, so they must not
# carry a VITE_ prefix — Vite compiles every VITE_ variable into the client
# bundle. Set them in the Vercel project's environment variables, not here.
# ---------------------------------------------------------------------------

# Clerk Production Secret Key (Clerk Dashboard > API Keys). Required by the
# proxy so Clerk can resolve which instance a forwarded request belongs to.
# CLERK_SECRET_KEY=

# Clerk Production Publishable Key. Optional; the proxy uses it only to pick
# the right Frontend API environment. Not a secret.
# CLERK_PUBLISHABLE_KEY=

# Pins the Clerk-Proxy-Url header sent upstream. Optional — the proxy otherwise
# derives it from the request's own origin. Set it to make preview deployments
# identify as the registered production proxy.
# CLERK_PROXY_URL=https://sensepro-six.vercel.app/__clerk
