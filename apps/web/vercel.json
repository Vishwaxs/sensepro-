{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:deploy",
  "outputDirectory": "dist/client",
  "framework": null,
  "rewrites": [
    { "source": "/__clerk", "destination": "/api/clerk-proxy?__clerk_proxy_path=/" },
    { "source": "/__clerk/(.*)", "destination": "/api/clerk-proxy?__clerk_proxy_path=/$1" },
    { "source": "/(.*)", "destination": "/_shell.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_shell.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
