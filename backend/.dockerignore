# Keep the build context small and, more importantly, keep secrets and local
# state out of the image. `COPY . .` would otherwise pull in .env — which holds
# the Supabase service-role key and the RTSP camera password — and bake it into
# a layer that anyone who can pull the image can read back.
.env
.env.*
!.env.example

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local run artefacts
*.log
uvicorn.err
uvicorn.log
enrollments.json

# Never ship enrolment media or evaluation dumps
eval/out/
*.mp4
*.mov
*.jpg
*.jpeg
*.png

.git/
.gitignore
Dockerfile
.dockerignore
